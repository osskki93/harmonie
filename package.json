{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve": "php artisan serve",
        "dev:full": "concurrently -n php,vite -c yellow,cyan \"php artisan serve\" \"vite\"",
        "share:prep": "npm run build && node scripts/remove-vite-hot.cjs",
        "share:start": "npm run share:prep && concurrently -n php,cloudflared -c yellow,green \"php artisan serve --host=127.0.0.1 --port=8000\" \"cloudflared tunnel --url http://127.0.0.1:8000\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
